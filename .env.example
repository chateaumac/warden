# ==============================================================================
# Warden Configuration Template
# ==============================================================================

# Directory where the SQLite database (warden.db), ADB keys, and custom profiles reside
WARDEN_DATA_DIR=/data

# Interval in seconds between background sanitization / anti-ACR audits (default: 900 = 15m)
WARDEN_AUDIT_INTERVAL=900

# Channel Guard poll frequency is set per device in the web UI (default: 30s).

# Subnet to sweep during LAN discovery (e.g., 192.168.1.0/24). Leave empty for mDNS only.
WARDEN_DISCOVERY_SUBNET=

# ------------------------------------------------------------------------------
# Authentication (REQUIRED) — Warden refuses to start until a mode is chosen.
#   oidc  : log in through an OpenID Connect provider (Authentik, Keycloak, ...)
#   basic : a single built-in username/password
#   none  : no login — only on a trusted, isolated network
# Any *_SECRET / *_HASH / *_TOKEN value can instead be read from a file by
# appending _FILE to the name (e.g. WARDEN_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc).
# ------------------------------------------------------------------------------
WARDEN_AUTH_MODE=

# basic: hash from `docker run --rm -it ghcr.io/chateaumac/warden python -m app.auth hash-password`
WARDEN_BASIC_USER=
WARDEN_BASIC_PASSWORD_HASH=

# oidc: redirect URI to register with the provider is <WARDEN_PUBLIC_URL>/auth/callback
WARDEN_PUBLIC_URL=
WARDEN_OIDC_ISSUER=
WARDEN_OIDC_CLIENT_ID=
WARDEN_OIDC_CLIENT_SECRET=
# Optional comma-separated groups (from the `groups` claim) allowed to log in
WARDEN_OIDC_ALLOWED_GROUPS=
# Session cookie signing key, 32+ chars: openssl rand -hex 32
WARDEN_SESSION_SECRET=

# Optional: lets Prometheus scrape /metrics with `Authorization: Bearer <token>`
WARDEN_METRICS_TOKEN=

# ------------------------------------------------------------------------------
# ADB key — anyone holding it can run shell commands on every TV that trusts it.
# ------------------------------------------------------------------------------
# Use an externally provisioned private key (the public key must sit next to it as
# <file>.pub). Keeps TV authorizations valid across container/volume rebuilds.
WARDEN_ADB_KEY_FILE=
# Set to false to never generate a new key (a missing key becomes a startup error)
WARDEN_ADB_KEYGEN=true

# Optional: Notification Webhook / ntfy topic URL
NOTIFY_URL=

# Optional: Home Assistant MQTT Integration
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
