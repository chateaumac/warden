# ==============================================================================
# Warden Configuration Template
# ==============================================================================

# Directory where SQLite database (warden.db), persistent ADB keys, and custom profiles reside
WARDEN_DATA_DIR=/data

# Interval in seconds between background sanitization / anti-ACR audits (default: 900 = 15m)
WARDEN_AUDIT_INTERVAL=900

# High-frequency polling interval in seconds for active playback monitoring (default: 1.2s)
WARDEN_GUARD_INTERVAL=1.2

# Subnet to sweep during LAN discovery (e.g., 192.168.1.0/24 or 10.10.40.0/24). Leave empty for mDNS only.
WARDEN_DISCOVERY_SUBNET=

# Optional: Notification Webhook / ntfy topic URL
NOTIFY_URL=

# Optional: Home Assistant MQTT Integration
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
